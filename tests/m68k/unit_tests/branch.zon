.{
    .vectors = .{},
    .tests = .{
        // Branch on signed HIgher (byte, taken)
        .{
            .env = .{
                .code = .{0x6204},
                .flags = .{ .c = false, .v = false, .z = false, .n = false, .x = false },
            },
            .expect = .{
                .disasm = "bhi.b #4",
                .clk = 10,
                .pc = 6,
            },
        },
        // Branch on signed HIgher (byte, not taken)
        .{
            .env = .{
                .code = .{0x6204},
                .flags = .{ .c = true, .v = false, .z = false, .n = false, .x = false },
            },
            .expect = .{
                .disasm = "bhi.b #4",
                .clk = 8,
                .pc = 2,
            },
        },
        // Branch on unsigned Lower or Same (word, taken)
        .{
            .env = .{
                .code = .{ 0x6300, 0x0004 },
                .flags = .{ .c = true, .v = false, .z = false, .n = false, .x = false },
            },
            .expect = .{
                .disasm = "bls.w #4",
                .clk = 10,
                .pc = 6,
            },
        },
        // Branch on unsigned Lower or Same (word, not taken)
        .{
            .env = .{
                .code = .{ 0x6300, 0x0004 },
                .flags = .{ .c = false, .v = false, .z = false, .n = false, .x = false },
            },
            .expect = .{
                .disasm = "bls.w #4",
                .clk = 12,
                .pc = 4,
            },
        },
        // Branch byte
        .{
            .env = .{
                .code = .{0x6004},
            },
            .expect = .{
                .disasm = "bra.b #4",
                .clk = 10,
                .pc = 6,
            },
        },
        // Branch word
        .{
            .env = .{
                .code = .{ 0x6100, 0x0004 },
            },
            .expect = .{
                .disasm = "bsr.w #4",
                .stack = .{0x0104},
                .clk = 18,
                .pc = 6,
            },
        },
        // Test condition, decrement, and branch (taken)
        .{
            .env = .{
                .code = .{ 0x51C8, 0x0004 },
                .data = .{0x0001},
            },
            .expect = .{
                .disasm = "dbf.w d0,#4",
                .pc = 6,
                .clk = 10,
            },
        },
        // Test condition, decrement, and branch (not taken, counter expired)
        .{
            .env = .{
                .code = .{ 0x51C8, 0x0004 },
                .data = .{0x0000},
            },
            .expect = .{
                .disasm = "dbf.w d0,#4",
                .pc = 4,
                .clk = 14,
            },
        },
        // Test condition, decrement, and branch (not taken, condition met)
        .{
            .env = .{
                .code = .{ 0x5BC8, 0x0004 },
                .data = .{0x0001},
                .flags = .{ .n = true },
            },
            .expect = .{
                .disasm = "dbmi.w d0,#4",
                .pc = 4,
                .clk = 12,
            },
        },
        // Jump to location (pc relative)
        .{
            .env = .{
                .code = .{ 0x4EFB, 0x0008 },
                .data = .{2},
            },
            .expect = .{
                .disasm = "jmp (#8,pc,d0.w)",
                .pc = 12,
                .clk = 14,
            },
        },
        // Jump to subroutine (address indirect)
        .{
            .env = .{
                .code = .{0x4E90},
                .addr = .{0x200},
            },
            .expect = .{
                .disasm = "jsr (a0)",
                .pc = 0x100,
                .stack = .{ 0x0000, 0x0102 },
                .clk = 16,
            },
        },
        // Return and restore condition codes
        .{
            .env = .{
                .code = .{0x4E77},
                .stack = .{ 0x0001, 0x0000, 0x0200 },
            },
            .expect = .{
                .disasm = "rtr",
                .pc = 0x100,
                .flags = .{ .x = false, .n = false, .z = false, .v = false, .c = true },
                .stack = .{},
                .clk = 20,
            },
        },
        // Return from subroutine
        .{
            .env = .{
                .code = .{0x4E75},
                .stack = .{ 0x0000, 0x0200 },
            },
            .expect = .{
                .disasm = "rts",
                .pc = 0x100,
                .stack = .{},
                .clk = 16,
            },
        },
    },
}
