.{
    .vectors = .{},
    .tests = .{
        .{
            .env = .{
                .code = .{0x9001},
                .data = .{ 0x10, 0x20 },
            },
            .expect = .{
                .disasm = "sub.b d1,d0",
                .clk = 4,
                .data = .{ 0xF0, 0x20 },
                .flags = .{ .c = true, .v = false, .z = false, .n = true, .x = true },
            },
        },
        .{
            .env = .{
                .code = .{0x9041},
                .data = .{ 0xFFFF, 0x0001 },
            },
            .expect = .{
                .disasm = "sub.w d1,d0",
                .clk = 4,
                .data = .{ 0xFFFE, 0x0001 },
                .flags = .{ .c = false, .v = false, .z = false, .n = true, .x = false },
            },
        },
        .{
            .env = .{
                .code = .{0x9081},
                .data = .{ 0x80000000, 0x1 },
            },
            .expect = .{
                .disasm = "sub.l d1,d0",
                .clk = 8,
                .data = .{ 0x7FFFFFFF, 0x1 },
                .flags = .{ .c = false, .v = true, .z = false, .n = false, .x = false },
            },
        },
        .{
            .env = .{
                .code = .{0x9101},
                .data = .{ 0x03, 0x02 },
                .flags = .{ .z = true, .x = true },
            },
            .expect = .{
                .disasm = "subx.b d1,d0",
                .clk = 4,
                .data = .{ 0x00, 0x02 },
                .flags = .{ .c = false, .v = false, .z = true, .n = false, .x = false },
            },
        },
        .{
            .env = .{
                .code = .{0x9102},
                .data = .{ 0x0, 0, 0x0 },
                .flags = .{ .x = false, .z = true },
            },
            .expect = .{
                .disasm = "subx.b d2,d0",
                .clk = 4,
                .data = .{ 0x0, 0, 0x0 },
                .flags = .{ .c = false, .v = false, .z = true, .n = false, .x = false },
            },
        },
        .{
            .env = .{
                .code = .{0x9103},
                .data = .{ 0x1, 0, 0, 0x0 },
                .flags = .{ .x = false, .z = true },
            },
            .expect = .{
                .disasm = "subx.b d3,d0",
                .clk = 4,
                .data = .{ 0x1, 0, 0, 0x0 },
                .flags = .{ .c = false, .v = false, .z = false, .n = false, .x = false },
            },
        },
        .{
            .env = .{
                .code = .{0x4840},
                .data = .{0xFFFF0000},
            },
            .expect = .{
                .disasm = "swap.w d0",
                .clk = 4,
                .data = .{0x0000FFFF},
                .flags = .{ .c = false, .v = false, .z = false, .n = false },
            },
        },
        .{
            .env = .{
                .code = .{0x4841},
                .data = .{ 0, 0x0000FFFF },
            },
            .expect = .{
                .disasm = "swap.w d1",
                .clk = 4,
                .data = .{ 0, 0xFFFF0000 },
                .flags = .{ .c = false, .v = false, .z = false, .n = true },
            },
        },
        .{
            .env = .{
                .code = .{0x4AC0},
                .data = .{0x00},
            },
            .expect = .{
                .disasm = "tas.b d0",
                .clk = 4,
                .data = .{0x80},
                .flags = .{ .c = false, .v = false, .z = true, .n = false },
            },
        },
        .{
            .env = .{
                .code = .{0x4AD0},
                .addr = .{0x1000},
                .ram = .{0x8000},
            },
            .expect = .{
                .disasm = "tas.b (a0)",
                .clk = 14,
                .ram = .{0x8000},
                .flags = .{ .c = false, .v = false, .z = false, .n = true },
            },
        },
    },
}
