.{
    .vectors = .{},
    .tests = .{
        .{
            .env = .{
                .code = .{0x4200},
                .data = .{0xFFFFFFFF},
            },
            .expect = .{
                .disasm = "clr.b d0",
                .clk = 4,
                .data = .{0xFFFFFF00},
                .flags = .{ .c = false, .v = false, .z = true, .n = false },
            },
        },
        .{
            .env = .{
                .code = .{0x4210},
                .addr = .{0x2000},
                .ram = .{0xFFFF},
            },
            .expect = .{
                .disasm = "clr.b (a0)",
                .clk = 12,
                .ram = .{0x00FF},
                .flags = .{ .c = false, .v = false, .z = true, .n = false },
            },
        },
        .{
            .env = .{
                .code = .{0x4280},
                .data = .{0xFFFFFFFF},
            },
            .expect = .{
                .disasm = "clr.l d0",
                .clk = 6,
                .data = .{0},
                .flags = .{ .c = false, .v = false, .z = true, .n = false },
            },
        },
    },
}
