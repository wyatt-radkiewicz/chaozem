.{
    .vectors = .{},
    .tests = .{
        .{
            .env = .{
                .code = .{0xC041},
                .data = .{ 0x0000FFFF, 0x00000F0F },
            },
            .expect = .{
                .disasm = "and.w d1,d0",
                .clk = 4,
                .data = .{ 0x00000F0F, 0x00000F0F },
                .flags = .{ .c = false, .v = false, .z = false, .n = false },
            },
        },
        .{
            .env = .{
                .code = .{0xC081},
                .data = .{ 0xFFFFFFFF, 0xF0F00F0F },
            },
            .expect = .{
                .disasm = "and.l d1,d0",
                .clk = 8,
                .data = .{ 0xF0F00F0F, 0xF0F00F0F },
                .flags = .{ .c = false, .v = false, .z = false, .n = true },
            },
        },
        .{
            .env = .{
                .code = .{ 0xC0B0, 0x1002 },
                .data = .{ 0xFFFFFFFF, 0x0002 },
                .ram = .{ 0x0000, 0x1234, 0x00FF },
                .addr = .{0x0FFE},
            },
            .expect = .{
                .disasm = "and.l (#2,a0,d1.w),d0",
                .clk = 20,
                .ram = .{ 0x0000, 0x1234, 0x00FF },
                .data = .{ 0x123400FF, 0x0002 },
                .addr = .{0x0FFE},
                .flags = .{ .c = false, .v = false, .z = false, .n = false },
            },
        },
        .{
            .env = .{
                .code = .{ 0xC1B0, 0x1002 },
                .data = .{ 0xF0F0F0F0, 0x0002 },
                .ram = .{ 0x0000, 0x8234, 0x00FF },
                .addr = .{0x0FFE},
            },
            .expect = .{
                .disasm = "and.l d0,(#2,a0,d1.w)",
                .clk = 26,
                .ram = .{ 0x0000, 0x8030, 0x00F0 },
                .data = .{ 0xF0F0F0F0, 0x0002 },
                .addr = .{0x0FFE},
                .flags = .{ .c = false, .v = false, .z = false, .n = true },
            },
        },
        .{
            .env = .{
                .code = .{ 0x0840, 3 },
                .data = .{0x00000000},
            },
            .expect = .{
                .disasm = "bchg.l #3,d0",
                .clk = 10,
                .data = .{0x00000008},
                .flags = .{ .z = true },
            },
        },
        .{
            .env = .{
                .code = .{ 0x0840, 59 },
                .data = .{0x0C000000},
            },
            .expect = .{
                .disasm = "bchg.l #27,d0",
                .clk = 12,
                .data = .{0x04000000},
                .flags = .{ .z = false },
            },
        },
        .{
            .env = .{
                .code = .{ 0x0878, 7, 0x1000 },
                .ram = .{0x0000},
            },
            .expect = .{
                .disasm = "bchg.b #7,($1000).w",
                .clk = 20,
                .ram = .{0x8000},
                .flags = .{ .z = true },
            },
        },
        .{
            .env = .{
                .code = .{0x0340},
                .data = .{ 0x0C000000, 59 },
            },
            .expect = .{
                .disasm = "bchg.l d1,d0",
                .clk = 8,
                .data = .{ 0x04000000, 59 },
                .flags = .{ .z = false },
            },
        },
        .{
            .env = .{
                .code = .{0x0380},
                .data = .{ 0x000F0000, 16 },
            },
            .expect = .{
                .disasm = "bclr.l d1,d0",
                .clk = 10,
                .data = .{ 0x000E0000, 16 },
                .flags = .{ .z = false },
            },
        },
    },
}
