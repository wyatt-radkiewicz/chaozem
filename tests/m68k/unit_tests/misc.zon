.{
    .vectors = .{
        .reset_pc = 0x100,
        .chk = 0x200,
    },
    .tests = .{
        .{
            .env = .{
                .code = .{0x4181},
                .data = .{ 50, 10 },
            },
            .expect = .{
                .disasm = "chk.w d1,d0",
                .clk = 10,
                .pc = 2,
            },
        },
        .{
            .env = .{
                .code = .{0x4182},
                .data = .{ 50, 0, 0xFFF6 },
            },
            .expect = .{
                .disasm = "chk.w d2,d0",
                .clk = 40,
                .pc = 0x100,
                .stack = .{ 0x2008, 0x0000, 0x0102 },
                .flags = .{ .n = true },
            },
        },
        .{
            .env = .{
                .code = .{0x4183},
                .data = .{ 50, 0, 0, 60 },
            },
            .expect = .{
                .disasm = "chk.w d3,d0",
                .clk = 36,
                .pc = 0x100,
                .stack = .{ 0x2000, 0x0000, 0x0102 },
                .flags = .{ .n = false },
            },
        },
        .{
            .env = .{
                .code = .{0xC141},
                .data = .{ 1, 2 },
            },
            .expect = .{
                .disasm = "exg.l d0,d1",
                .data = .{ 2, 1 },
                .clk = 6,
            },
        },
        .{
            .env = .{
                .code = .{0xC149},
                .addr = .{ 1, 2 },
            },
            .expect = .{
                .disasm = "exg.l a0,a1",
                .addr = .{ 2, 1 },
                .clk = 6,
            },
        },
        .{
            .env = .{
                .code = .{0xC188},
                .data = .{1},
                .addr = .{2},
            },
            .expect = .{
                .disasm = "exg.l d0,a0",
                .data = .{2},
                .addr = .{1},
                .clk = 6,
            },
        },
        .{
            .env = .{
                .code = .{0x4880},
                .data = .{0xFF00},
            },
            .expect = .{
                .disasm = "ext.w d0",
                .data = .{0x0000},
                .flags = .{ .c = false, .v = false, .n = false, .z = true },
                .clk = 4,
            },
        },
        .{
            .env = .{
                .code = .{0x4880},
                .data = .{0x0080},
            },
            .expect = .{
                .disasm = "ext.w d0",
                .data = .{0xFF80},
                .flags = .{ .c = false, .v = false, .n = true, .z = false },
                .clk = 4,
            },
        },
        .{
            .env = .{
                .code = .{0x48C0},
                .data = .{0xFFFF0F00},
            },
            .expect = .{
                .disasm = "ext.l d0",
                .data = .{0x00000F00},
                .flags = .{ .c = false, .v = false, .n = false, .z = false },
                .clk = 4,
            },
        },
        .{
            .env = .{
                .code = .{0x4AFC},
            },
            .expect = .{
                .disasm = "illegal",
                .pc = 0x100,
                .clk = 34,
            },
        },
        .{
            .env = .{
                .code = .{ 0x4E50, 0xFFFE },
                .addr = .{0x1122AA55},
            },
            .expect = .{
                .disasm = "link.w a0,#-2",
                .clk = 16,
                .addr = .{0x1FFC},
                .ssp = 0x1FFA,
                .stack = .{ 0x0000, 0x1122, 0xAA55 },
            },
        },
        .{
            .env = .{
                .code = .{0x4840},
                .data = .{0xFFFF0000},
            },
            .expect = .{
                .disasm = "swap.w d0",
                .clk = 4,
                .data = .{0x0000FFFF},
                .flags = .{ .c = false, .v = false, .z = false, .n = false },
            },
        },
        .{
            .env = .{
                .code = .{0x4841},
                .data = .{ 0, 0x0000FFFF },
            },
            .expect = .{
                .disasm = "swap.w d1",
                .clk = 4,
                .data = .{ 0, 0xFFFF0000 },
                .flags = .{ .c = false, .v = false, .z = false, .n = true },
            },
        },
        .{
            .env = .{
                .code = .{0x4AC0},
                .data = .{0x00},
            },
            .expect = .{
                .disasm = "tas.b d0",
                .clk = 4,
                .data = .{0x80},
                .flags = .{ .c = false, .v = false, .z = true, .n = false },
            },
        },
        .{
            .env = .{
                .code = .{0x4AD0},
                .addr = .{0x1000},
                .ram = .{0x8000},
            },
            .expect = .{
                .disasm = "tas.b (a0)",
                .clk = 14,
                .ram = .{0x8000},
                .flags = .{ .c = false, .v = false, .z = false, .n = true },
            },
        },
        .{
            .env = .{
                .code = .{0x4E40},
            },
            .expect = .{
                .disasm = "trap #0",
                .clk = 34,
                .pc = 0x100,
                .stack = .{ 0x2000, 0x0000, 0x0102 },
            },
        },
        .{
            .env = .{
                .code = .{0x4E76},
                .flags = .{ .v = true },
            },
            .expect = .{
                .disasm = "trapv",
                .clk = 34,
                .pc = 0x100,
                .stack = .{ 0x2002, 0x0000, 0x0102 },
            },
        },
        .{
            .env = .{
                .code = .{0x4E76},
                .flags = .{ .v = false },
            },
            .expect = .{
                .disasm = "trapv",
                .clk = 4,
            },
        },
        .{
            .env = .{
                .code = .{0x4E58},
                .addr = .{0x1FFC},
                .stack = .{ 0x0000, 0x0001, 0x0002, 0x0003 },
            },
            .expect = .{
                .disasm = "unlk.w a0",
                .addr = .{0x00020003},
                .clk = 12,
            },
        },
    },
}
