.{
    .vectors = .{
        .reset_pc = 0x100,
        .chk = 0x200,
    },
    .tests = .{
        .{
            .env = .{
                .code = .{0x4181},
                .data = .{ 50, 10 },
            },
            .expect = .{
                .disasm = "chk.w d1,d0",
                .clk = 10,
                .pc = 2,
            },
        },
        .{
            .env = .{
                .code = .{0x4182},
                .data = .{ 50, 0, 0xFFF6 },
            },
            .expect = .{
                .disasm = "chk.w d2,d0",
                .clk = 40,
                .pc = 0x100,
                .stack = .{ 0x2008, 0x0000, 0x0102 },
                .flags = .{ .n = true },
            },
        },
        .{
            .env = .{
                .code = .{0x4183},
                .data = .{ 50, 0, 0, 60 },
            },
            .expect = .{
                .disasm = "chk.w d3,d0",
                .clk = 36,
                .pc = 0x100,
                .stack = .{ 0x2000, 0x0000, 0x0102 },
                .flags = .{ .n = false },
            },
        },
    },
}
