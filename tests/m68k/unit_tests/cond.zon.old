.{
    .vectors = .{},
    .tests = .{
        .{
            .env = .{
                .code = .{0xB240},
                .data = .{ 0, 0 },
            },
            .expect = .{
                .disasm = "cmp.w d0,d1",
                .clk = 4,
                .flags = .{ .n = false, .z = true, .v = false, .c = false },
            },
        },
        .{
            .env = .{
                .code = .{0xB001},
                .data = .{ 10, 0 },
            },
            .expect = .{
                .disasm = "cmp.b d1,d0",
                .clk = 4,
                .flags = .{ .n = false, .z = false, .v = false, .c = false },
            },
        },
        .{
            .env = .{
                .code = .{0xB002},
                .data = .{ 0, 0, 10 },
            },
            .expect = .{
                .disasm = "cmp.b d2,d0",
                .clk = 4,
                .flags = .{ .n = true, .z = false, .v = false, .c = true },
            },
        },
        .{
            .env = .{
                .code = .{0xB003},
                .data = .{ 128, 0, 0, 100 },
            },
            .expect = .{
                .disasm = "cmp.b d3,d0",
                .clk = 4,
                .flags = .{ .n = false, .z = false, .v = true, .c = false },
            },
        },
        .{
            .env = .{
                .code = .{0xB0C1},
                .data = .{0x10000},
                .addr = .{0x8000},
            },
            .expect = .{
                .disasm = "cmpa.w d1,a0",
                .clk = 6,
                .flags = .{ .n = false, .z = false, .v = false, .c = false },
            },
        },
        .{
            .env = .{
                .code = .{ 0x0C00, 0x000F },
                .data = .{0x0F},
            },
            .expect = .{
                .disasm = "cmpi.b #$0f,d0",
                .clk = 8,
                .flags = .{ .n = false, .z = true, .v = false, .c = false },
            },
        },
        .{
            .env = .{
                .code = .{0xB109},
                .addr = .{ 0x2000, 0x2002 },
                .ram = .{ 0xFF00, 0x1000 },
            },
            .expect = .{
                .disasm = "cmpm.b (a1)+,(a0)+",
                .clk = 12,
                .addr = .{ 0x2001, 0x2003 },
                .flags = .{ .n = true, .z = false, .v = false, .c = false },
            },
        },
    },
}
