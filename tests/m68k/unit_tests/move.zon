.{
    .vectors = .{},
    .tests = .{
        .{
            .env = .{
                .code = .{0x43D0},
                .addr = .{ 10, 0 },
            },
            .expect = .{
                .disasm = "lea.l (a0),a1",
                .clk = 4,
                .addr = .{ 10, 10 },
            },
        },
        .{
            .env = .{
                .code = .{0x1001},
                .data = .{ 0, 10 },
            },
            .expect = .{
                .disasm = "move.b d1,d0",
                .clk = 4,
                .data = .{ 10, 10 },
            },
        },
        .{
            .env = .{
                .code = .{0x3041},
                .data = .{ 0, 0x800A },
                .addr = .{0},
            },
            .expect = .{
                .disasm = "movea.w d1,a0",
                .clk = 4,
                .data = .{ 0, 0x800A },
                .addr = .{0xFFFF800A},
            },
        },
    },
}
