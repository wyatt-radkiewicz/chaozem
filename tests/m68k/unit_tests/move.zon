.{
    .vectors = .{},
    .tests = .{
        .{
            .env = .{
                .code = .{0x43D0},
                .addr = .{ 10, 0 },
            },
            .expect = .{
                .disasm = "lea.l (a0),a1",
                .clk = 4,
                .addr = .{ 10, 10 },
            },
        },
        .{
            .env = .{
                .code = .{0x1001},
                .data = .{ 0, 10 },
            },
            .expect = .{
                .disasm = "move.b d1,d0",
                .clk = 4,
                .data = .{ 10, 10 },
            },
        },
        .{
            .env = .{
                .code = .{0x3041},
                .data = .{ 0, 0x800A },
                .addr = .{0},
            },
            .expect = .{
                .disasm = "movea.w d1,a0",
                .clk = 4,
                .data = .{ 0, 0x800A },
                .addr = .{0xFFFF800A},
            },
        },
        .{
            .env = .{
                .code = .{0x44C0},
                .data = .{0x001f},
                .flags = .{ .c = false, .v = false, .z = false, .n = false, .x = false },
            },
            .expect = .{
                .disasm = "move.w d0,sr",
                .clk = 12,
                .data = .{0x001f},
                .flags = .{ .c = true, .v = true, .z = true, .n = true, .x = true },
            },
        },
        .{
            .env = .{
                .code = .{0x40C0},
                .data = .{0xFFFFFFFF},
                .flags = .{ .c = true, .v = false, .z = true, .n = false, .x = true },
            },
            .expect = .{
                .disasm = "move.w sr,d0",
                .clk = 6,
                .data = .{0xFFFF2015},
                .flags = .{ .c = true, .v = false, .z = true, .n = false, .x = true },
            },
        },
    },
}
