.{
    .vectors = .{},
    .tests = .{
        .{
            .env = .{
                .code = .{0x43D0},
                .addr = .{ 10, 0 },
            },
            .expect = .{
                .disasm = "lea.l (a0),a1",
                .clk = 4,
                .addr = .{ 10, 10 },
            },
        },
        .{
            .env = .{
                .code = .{0x1001},
                .data = .{ 0, 10 },
            },
            .expect = .{
                .disasm = "move.b d1,d0",
                .clk = 4,
                .data = .{ 10, 10 },
            },
        },
        .{
            .env = .{
                .code = .{0x3041},
                .data = .{ 0, 0x800A },
                .addr = .{0},
            },
            .expect = .{
                .disasm = "movea.w d1,a0",
                .clk = 4,
                .data = .{ 0, 0x800A },
                .addr = .{0xFFFF800A},
            },
        },
        .{
            .env = .{
                .code = .{0x44C0},
                .data = .{0x001f},
                .flags = .{ .c = false, .v = false, .z = false, .n = false, .x = false },
            },
            .expect = .{
                .disasm = "move.w d0,sr",
                .clk = 12,
                .data = .{0x001f},
                .flags = .{ .c = true, .v = true, .z = true, .n = true, .x = true },
            },
        },
        .{
            .env = .{
                .code = .{0x40C0},
                .data = .{0xFFFFFFFF},
                .flags = .{ .c = true, .v = false, .z = true, .n = false, .x = true },
            },
            .expect = .{
                .disasm = "move.w sr,d0",
                .clk = 6,
                .data = .{0xFFFF2015},
                .flags = .{ .c = true, .v = false, .z = true, .n = false, .x = true },
            },
        },
        .{
            .env = .{
                .code = .{ 0x4892, 0x0303 },
                .data = .{ 0xABCD, 0x1234 },
                .addr = .{ 0xFFFF, 0x0001, 0x1000 },
            },
            .expect = .{
                .disasm = "movem.w d0-d1/a0-a1,(a2)",
                .clk = 24,
                .data = .{ 0xABCD, 0x1234 },
                .addr = .{ 0xFFFF, 0x0001, 0x1000 },
                .ram = .{ 0xABCD, 0x1234, 0xFFFF, 0x0001 },
            },
        },
        .{
            .env = .{
                .code = .{ 0x48A7, 0xC0C0 },
                .data = .{ 0xABCD, 0x1234 },
                .addr = .{ 0xFFFF, 0x0001 },
            },
            .expect = .{
                .disasm = "movem.w d0-d1/a0-a1,-(sp)",
                .clk = 24,
                .data = .{ 0xABCD, 0x1234 },
                .addr = .{ 0xFFFF, 0x0001 },
                .ssp = 0x1FF8,
                .stack = .{ 0xABCD, 0x1234, 0xFFFF, 0x0001 },
            },
        },
        .{
            .env = .{
                .code = .{ 0x4C92, 0x0303 },
                .data = .{ 0, 0 },
                .addr = .{ 0, 0, 0x1000 },
                .ram = .{ 0xABCD, 0x1234, 0xFFFF, 0x0001 },
            },
            .expect = .{
                .disasm = "movem.w (a2),d0-d1/a0-a1",
                .clk = 24,
                .data = .{ 0xABCD, 0x1234 },
                .addr = .{ 0xFFFF, 0x0001, 0x1000 },
                .ram = .{ 0xABCD, 0x1234, 0xFFFF, 0x0001 },
            },
        },
        .{
            .env = .{
                .code = .{ 0x4C9F, 0x0303 },
                .stack = .{ 0xABCD, 0x1234, 0xFFFF, 0x0001 },
            },
            .expect = .{
                .disasm = "movem.w (sp)+,d0-d1/a0-a1",
                .clk = 24,
                .data = .{ 0xABCD, 0x1234 },
                .addr = .{ 0xFFFF, 0x0001 },
                .ssp = 0x2000,
            },
        },
        .{
            .env = .{
                .code = .{ 0x01C8, 0x0002 },
                .data = .{0x12345678},
                .addr = .{0x0FFE},
            },
            .expect = .{
                .disasm = "movep.l d0,(#2,a0)",
                .clk = 24,
                .ram = .{ 0x1200, 0x3400, 0x5600, 0x7800 },
                .data = .{0x12345678},
                .addr = .{0x0FFE},
            },
        },
        .{
            .env = .{
                .code = .{ 0x0108, 0x0002 },
                .data = .{0x0000},
                .addr = .{0x0FFE},
                .ram = .{ 0x1200, 0x3400 },
            },
            .expect = .{
                .disasm = "movep.w (#2,a0),d0",
                .clk = 16,
                .data = .{0x1234},
            },
        },
        .{
            .env = .{
                .code = .{0x70FF},
                .data = .{0x0000},
            },
            .expect = .{
                .disasm = "moveq.l #-1,d0",
                .data = .{0xFFFFFFFF},
                .flags = .{ .z = false, .n = true, .c = false, .v = false },
                .clk = 4,
            },
        },
        .{
            .env = .{
                .code = .{0x7000},
                .data = .{0xFFFFFFFF},
            },
            .expect = .{
                .disasm = "moveq.l #0,d0",
                .data = .{0},
                .flags = .{ .z = true, .n = false, .c = false, .v = false },
                .clk = 4,
            },
        },
        .{
            .env = .{
                .code = .{ 0x4870, 0x0002 },
                .data = .{0x0001},
                .addr = .{0xF00F0000},
            },
            .expect = .{
                .disasm = "pea.l (#2,a0,d0.w)",
                .stack = .{ 0xF00F, 0x0003 },
                .clk = 20,
            },
        },
        .{
            .env = .{
                .code = .{0x57C0},
                .data = .{0xFF00},
                .flags = .{ .z = true },
            },
            .expect = .{
                .disasm = "seq.b d0",
                .data = .{0xFFFF},
                .clk = 6,
            },
        },
        .{
            .env = .{
                .code = .{0x57C1},
                .data = .{ 0, 0xFFFF },
                .flags = .{ .z = false },
            },
            .expect = .{
                .disasm = "seq.b d1",
                .data = .{ 0, 0xFF00 },
                .clk = 4,
            },
        },
        .{
            .env = .{
                .code = .{0x4E68},
                .addr = .{0x1234},
            },
            .expect = .{
                .disasm = "move.l usp,a0",
                .addr = .{0x2000},
                .clk = 4,
            },
        },
        .{
            .env = .{
                .code = .{0x4E60},
                .addr = .{0x1234},
            },
            .expect = .{
                .disasm = "move.l a0,usp",
                .usp = 0x1234,
                .clk = 4,
            },
        },
        .{
            .env = .{
                .code = .{ 0x4CEF, 0x0004, 0x0000 },
                .stack = .{ 0x1234, 0x5678 },
            },
            .expect = .{
                .disasm = "movem.l (#0,sp),d2",
                .clk = 20,
                .data = .{ 0, 0, 0x12345678 },
                .stack = .{},
            },
        },
        .{
            .env = .{
                .code = .{ 0x1033, 0x0800 },
                .ram = .{ 0x0000, 0x000F },
                .data = .{0x00000003},
                .addr = .{ 0, 0, 0, 0x00001000 },
            },
            .expect = .{
                .disasm = "move.b (#0,a3,d0.l),d0",
                .clk = 14,
                .data = .{0x0000000F},
                .addr = .{ 0, 0, 0, 0x00001000 },
            },
        },
    },
}
